+#if !defined(LIBCCAP_ILOG2)
+// https://stackoverflow.com/a/22418446
+LIBCCAP_INTERNAL_FUNC_PREFIX uint8_t libccap_ilog2(uint64_t x) {
+    if (x == 0) return 0;
+
+    return 64 - __builtin_clzl(x) - 1;
+}
+#define LIBCCAP_ILOG2(x) libccap_ilog2(x)
