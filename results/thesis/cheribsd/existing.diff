+LIBCCAP_USE_RESULT_FUNC_PREFIX
+LIBCCAP_EXTERNAL_FUNC_PREFIX CCapResult ccap2024_11_read_secret_id(const struct CCap2024_11 *cap, uint32_t *secret_id) {
