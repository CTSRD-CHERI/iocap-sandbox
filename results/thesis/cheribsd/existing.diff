+static void	vtblk_iocap_drain(struct vtblk_iocap_softc *);
+
+static void	vtblk_iocap_startio(struct vtblk_iocap_softc *);
+static void	vtblk_iocap_bio_done(struct vtblk_iocap_softc *, struct bio *, int);
